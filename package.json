{
  "name": "car-racer",
  "version": "0.2.42",
  "private": true,
  "type": "module",
  "description": "Crash Circuit — arcade racer (free OSS stack)",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "free:dev": "node scripts/free-dev-port.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "cars:glb": "node scripts/write-car-glbs.mjs",
    "cars:polish": "node scripts/polish-car-glbs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
